{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "ResolveTheReleaseByDigestAndVerifyIt",
      "Effect": "Allow",
      "Action": [
        "ecr:BatchGetImage",
        "ecr:GetDownloadUrlForLayer",
        "ecr:BatchCheckLayerAvailability",
        "ecr:DescribeImages"
      ],
      "Resource": "arn:aws:ecr:<REGION>:<AWS_ACCOUNT_ID>:repository/<APP>"
    },
    {
      "Sid": "RegistryToken",
      "Effect": "Allow",
      "Action": "ecr:GetAuthorizationToken",
      "Resource": "*"
    },
    {
      "Sid": "ReadTheDevMigrationMarker",
      "Effect": "Allow",
      "Action": [
        "s3:GetObject",
        "s3:GetObjectVersion"
      ],
      "Resource": "arn:aws:s3:::<PROMOTION_BUCKET>/promotions/migrate-backend/*"
    },
    {
      "Sid": "TellMissingFromDenied",
      "Effect": "Allow",
      "Action": "s3:ListBucket",
      "Resource": "arn:aws:s3:::<PROMOTION_BUCKET>",
      "Condition": {
        "StringLike": {
          "s3:prefix": "promotions/migrate-backend/*"
        }
      }
    },
    {
      "Sid": "StartOnlyThePinnedMigrationRunbook",
      "Effect": "Allow",
      "Action": "ssm:StartAutomationExecution",
      "Resource": "arn:aws:ssm:<REGION>:<AWS_ACCOUNT_ID>:automation-definition/<MIGRATE_DOCUMENT_NAME>-prod:<DOCUMENT_VERSION>"
    },
    {
      "Sid": "ReadItsOutcome",
      "Effect": "Allow",
      "Action": [
        "ssm:GetAutomationExecution",
        "ssm:DescribeAutomationStepExecutions"
      ],
      "Resource": "*"
    },
    {
      "Sid": "PassOnlyTheMigrationRunbookRoleToTheRunbook",
      "Effect": "Allow",
      "Action": "iam:PassRole",
      "Resource": "arn:aws:iam::<AWS_ACCOUNT_ID>:role/migrate-runbook-prod",
      "Condition": {
        "StringEquals": {
          "iam:PassedToService": "ssm.amazonaws.com"
        }
      }
    },
    {
      "Sid": "NoDatabaseAndNoFleetAccessFromTheRunner",
      "Effect": "Deny",
      "Action": [
        "rds:*",
        "rds-db:connect",
        "ec2:*",
        "autoscaling:*",
        "ssm:SendCommand",
        "ssm:StartSession",
        "ssm:GetParameter",
        "ssm:GetParameters",
        "ssm:GetParametersByPath",
        "secretsmanager:GetSecretValue",
        "s3:DeleteObject",
        "s3:DeleteObjectVersion",
        "s3:PutObject"
      ],
      "Resource": "*"
    }
  ]
}
