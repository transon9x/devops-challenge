{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "PullTheReleaseAndItsReferrers",
      "Effect": "Allow",
      "Action": [
        "ecr:BatchGetImage",
        "ecr:GetDownloadUrlForLayer",
        "ecr:BatchCheckLayerAvailability",
        "ecr:DescribeImages"
      ],
      "Resource": "arn:aws:ecr:<REGION>:<AWS_ACCOUNT_ID>:repository/<APP>"
    },
    {
      "Sid": "RegistryToken",
      "Effect": "Allow",
      "Action": "ecr:GetAuthorizationToken",
      "Resource": "*"
    },
    {
      "Sid": "ReadPromotionMarkers",
      "Effect": "Allow",
      "Action": [
        "s3:GetObject",
        "s3:GetObjectVersion"
      ],
      "Resource": "arn:aws:s3:::<PROMOTION_BUCKET>/promotions/backend/*"
    },
    {
      "Sid": "TellMissingFromDenied",
      "Effect": "Allow",
      "Action": "s3:ListBucket",
      "Resource": "arn:aws:s3:::<PROMOTION_BUCKET>",
      "Condition": {
        "StringLike": {
          "s3:prefix": "promotions/backend/*"
        }
      }
    },
    {
      "Sid": "ProdCannotWriteItsOwnProvenance",
      "Effect": "Deny",
      "Action": "s3:PutObject",
      "Resource": "arn:aws:s3:::<PROMOTION_BUCKET>/*"
    },
    {
      "Sid": "NobodyDeletes",
      "Effect": "Deny",
      "Action": [
        "s3:DeleteObject",
        "s3:DeleteObjectVersion",
        "ecr:BatchDeleteImage"
      ],
      "Resource": "*"
    },
    {
      "Sid": "StartOnlyThePinnedDeployRunbook",
      "Effect": "Allow",
      "Action": "ssm:StartAutomationExecution",
      "Resource": "arn:aws:ssm:<REGION>:<AWS_ACCOUNT_ID>:automation-definition/<DEPLOY_DOCUMENT_NAME>-prod:<DOCUMENT_VERSION>"
    },
    {
      "Sid": "ReadItsOutcome",
      "Effect": "Allow",
      "Action": [
        "ssm:GetAutomationExecution",
        "ssm:DescribeAutomationStepExecutions"
      ],
      "Resource": "*"
    },
    {
      "Sid": "PassOnlyTheRunbookRoleToTheRunbook",
      "Effect": "Allow",
      "Action": "iam:PassRole",
      "Resource": "arn:aws:iam::<AWS_ACCOUNT_ID>:role/deploy-runbook-prod",
      "Condition": {
        "StringEquals": {
          "iam:PassedToService": "ssm.amazonaws.com"
        }
      }
    },
    {
      "Sid": "NoDirectFleetAccess",
      "Effect": "Deny",
      "Action": [
        "ec2:*",
        "autoscaling:*",
        "ssm:SendCommand",
        "ssm:StartSession",
        "elasticloadbalancing:*"
      ],
      "Resource": "*"
    }
  ]
}
