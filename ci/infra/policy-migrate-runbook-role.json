{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "TakeTheRestorePointBeforeAnySchemaChange",
      "Effect": "Allow",
      "Action": [
        "rds:CreateDBClusterSnapshot",
        "rds:AddTagsToResource"
      ],
      "Resource": [
        "arn:aws:rds:<REGION>:<AWS_ACCOUNT_ID>:cluster:<DB_CLUSTER_IDENTIFIER>",
        "arn:aws:rds:<REGION>:<AWS_ACCOUNT_ID>:cluster-snapshot:pre-migrate-*"
      ]
    },
    {
      "Sid": "DescribeIsNotResourceScoped",
      "Effect": "Allow",
      "Action": [
        "rds:DescribeDBClusterSnapshots",
        "ec2:DescribeInstances",
        "ec2:DescribeLaunchTemplates",
        "ec2:DescribeLaunchTemplateVersions"
      ],
      "Resource": "*"
    },
    {
      "Sid": "OneJobHostFromTheOneMigrationTemplate",
      "Effect": "Allow",
      "Action": "ec2:RunInstances",
      "Resource": "*",
      "Condition": {
        "ArnEquals": {
          "ec2:LaunchTemplate": "arn:aws:ec2:<REGION>:<AWS_ACCOUNT_ID>:launch-template/<MIGRATION_LAUNCH_TEMPLATE_ID>"
        },
        "Bool": {
          "ec2:IsLaunchTemplateResource": "true"
        }
      }
    },
    {
      "Sid": "TagTheJobHostWithTheReleaseItMustApply",
      "Effect": "Allow",
      "Action": "ec2:CreateTags",
      "Resource": "arn:aws:ec2:<REGION>:<AWS_ACCOUNT_ID>:instance/*",
      "Condition": {
        "StringEquals": {
          "ec2:CreateAction": "RunInstances"
        }
      }
    },
    {
      "Sid": "TerminateOnlyAMigrationJobHost",
      "Effect": "Allow",
      "Action": "ec2:TerminateInstances",
      "Resource": "arn:aws:ec2:<REGION>:<AWS_ACCOUNT_ID>:instance/*",
      "Condition": {
        "StringEquals": {
          "ec2:ResourceTag/app:job": "migrate"
        }
      }
    },
    {
      "Sid": "PassOnlyTheJobInstanceRole",
      "Effect": "Allow",
      "Action": "iam:PassRole",
      "Resource": "arn:aws:iam::<AWS_ACCOUNT_ID>:role/backend-migrate-job",
      "Condition": {
        "StringEquals": {
          "iam:PassedToService": "ec2.amazonaws.com"
        }
      }
    },
    {
      "Sid": "SeedAndReadTheOutcomeParameters",
      "Effect": "Allow",
      "Action": [
        "ssm:GetParameter",
        "ssm:PutParameter"
      ],
      "Resource": "arn:aws:ssm:<REGION>:<AWS_ACCOUNT_ID>:parameter<MIGRATION_RESULT_PARAMETER_PREFIX>/*"
    },
    {
      "Sid": "NoRemoteExecutionAndNoDatabaseCredentials",
      "Effect": "Deny",
      "Action": [
        "ssm:SendCommand",
        "ssm:StartSession",
        "rds-db:connect",
        "rds:ModifyDBCluster",
        "rds:DeleteDBCluster",
        "rds:DeleteDBClusterSnapshot",
        "rds:RestoreDBClusterFromSnapshot",
        "secretsmanager:GetSecretValue",
        "autoscaling:*"
      ],
      "Resource": "*"
    }
  ]
}
