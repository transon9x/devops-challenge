# Copy to .env only if you want to override the defaults baked into
# docker-compose.yml. The stack runs without this file.
#
# Nothing here is a production secret. In a real environment these come from a
# secret manager (Vault / AWS Secrets Manager) and are injected at runtime.
POSTGRES_DB=appdb
POSTGRES_USER=postgres
POSTGRES_PASSWORD=
APP_DB_USER=app
APP_DB_PASSWORD=

# Per-replica pool ceiling. Keep replicas * DB_POOL_MAX inside the documented
# budget: max_connections (100) - superuser_reserved_connections (3) = 97 usable,
# and leave at least 40 free for migrations, monitoring and ad-hoc access.
DB_POOL_MAX=8
